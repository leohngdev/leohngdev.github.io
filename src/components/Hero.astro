---
import { profile } from '../data/profile';
import Terminal from './Terminal.tsx';
import type { TerminalData } from '../lib/terminal-data';

interface Props {
  terminalData: TerminalData;
}

const { terminalData } = Astro.props;
---

<section class="pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div class="container-page">
    <!--
      The name is demoted on purpose. Nobody scans a portfolio looking for a name,
      and the h1 is the one piece of display-scale real estate on the page — it goes
      to the claim, not the label. The name still reads first in the DOM, so screen
      readers and the document outline are unaffected.
    -->
    <p class="reveal datum flex items-center gap-2 text-[var(--text-secondary)]">
      {profile.displayName}
      <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
      {profile.role}
    </p>

    <!--
      The thesis spans the full container rather than sharing a row with the terminal.
      At display size a half-width column broke it across three ragged lines, which
      costs exactly the instant legibility the line exists to buy.
    -->
    <h1
      class="reveal text-display mt-4 max-w-[19ch] font-semibold tracking-[-0.02em]"
      style="transition-delay: 60ms"
    >
      {profile.thesis}
    </h1>

    <!--
      min-w-0 on both columns: grid items default to min-width:auto, so the terminal's
      long unbreakable mono lines were sizing the column to their own max-content and
      pushing the whole page 6px wider than the viewport on a 375px screen.
    -->
    <div class="mt-10 grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div class="min-w-0">
        <p class="reveal text-lede max-w-xl text-[var(--text-secondary)]" style="transition-delay: 120ms">
          {profile.heroProof}
        </p>

        <p class="reveal eyebrow mt-7 flex items-center gap-2" style="transition-delay: 180ms">
          <span class="text-[var(--accent)]" aria-hidden="true">&#9679;</span>
          {profile.available}
        </p>

        <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="transition-delay: 240ms">
          <a
            href="#work"
            class="rounded-lg bg-[var(--text-primary)] px-5 py-2.5 text-sm font-medium text-[var(--surface)] transition-opacity hover:opacity-88"
          >
            View selected work
          </a>
          <a
            href={profile.resume}
            download
            class="rounded-lg border border-[var(--border-strong)] px-5 py-2.5 text-sm font-medium transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            Download CV
          </a>
          <a
            href={`mailto:${profile.email}`}
            class="px-1 py-2.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
          >
            Get in touch
          </a>
        </div>
      </div>

      <div class="reveal min-w-0 lg:pl-4" style="transition-delay: 300ms">
        <p class="eyebrow mb-3 flex items-center gap-2">
          <span aria-hidden="true">&#8595;</span>
          {profile.terminalHint}
        </p>
        <!--
          client:visible keeps the island off the critical path: the hero paints
          as static HTML and React only hydrates once the terminal is on screen.
        -->
        <Terminal data={terminalData} client:visible />
      </div>
    </div>
  </div>
</section>
