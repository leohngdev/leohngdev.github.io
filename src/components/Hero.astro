---
import { profile } from '../data/profile';
import Instrument from './Instrument.astro';
import CostExplorer from './CostExplorer.astro';

/**
 * The thesis is split into words at build time so each can be revealed
 * independently. Splitting in the browser would mean shipping a string-manipulation
 * step just to animate, and would leave the headline momentarily unstyled.
 *
 * Line breaks are authored rather than left to the browser: at display size the
 * break position is a typographic decision, not something to discover at runtime.
 */
const thesisLines = ['Games taught me', 'what software costs.'];
---

<section class="pt-16 pb-20 sm:pt-24 sm:pb-28" data-hero>
  <div class="container-page">
    <!--
      The name is demoted on purpose. Nobody scans a portfolio looking for a name,
      and the h1 is the one piece of display-scale real estate on the page — it goes
      to the claim, not the label. The name still reads first in the DOM, so screen
      readers and the document outline are unaffected.
    -->
    <p class="datum flex items-center gap-2 text-[var(--text-secondary)]" data-hero-item="0">
      {profile.displayName}
      <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
      {profile.role}
    </p>

    <h1 class="text-display mt-4 max-w-[19ch] font-semibold tracking-[-0.02em]" data-hero-thesis>
      {
        thesisLines.map((line) => (
          <span class="block">
            {line.split(' ').map((word) => (
              <span class="hero-word inline-block">{word}&nbsp;</span>
            ))}
          </span>
        ))
      }
    </h1>

    <div class="mt-10 grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div class="min-w-0">
        <p class="text-lede max-w-xl text-[var(--text-secondary)]" data-hero-item="1">
          {profile.heroProof}
        </p>

        <p class="eyebrow mt-7 flex items-center gap-2" data-hero-item="2">
          <span class="text-[var(--accent)]" aria-hidden="true">&#9679;</span>
          {profile.available}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-hero-item="3">
          <a
            href="#work"
            class="rounded-lg bg-[var(--text-primary)] px-5 py-2.5 text-sm font-medium text-[var(--surface)] transition-opacity hover:opacity-88"
          >
            View selected work
          </a>
          <a
            href={profile.resume}
            download
            data-astro-prefetch="false"
            class="rounded-lg border border-[var(--border-strong)] px-5 py-2.5 text-sm font-medium transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            Download CV
          </a>
          <button
            type="button"
            data-palette-open
            class="px-1 py-2.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
            aria-haspopup="dialog"
          >
            Or type a command
          </button>
        </div>

        <Instrument variant="line" class="mt-8 text-[var(--text-muted)]" data-hero-item="4" />
      </div>

      <div class="min-w-0" data-hero-item="5">
        <CostExplorer />
      </div>
    </div>
  </div>
</section>

<style>
  /* The hero is the only place on the site that animates without waiting to be
     scrolled to, because it is already in view. Everything starts hidden and the
     .hero-play class on the section releases it. */
  [data-hero] .hero-word,
  [data-hero] [data-hero-item] {
    opacity: 0;
    transform: translateY(20px);
  }

  [data-hero] .hero-word {
    filter: blur(6px);
  }

  [data-hero].hero-play .hero-word {
    opacity: 1;
    filter: blur(0);
    transform: none;
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-hero].hero-play [data-hero-item] {
    opacity: 1;
    transform: none;
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Nothing is hidden without JavaScript, and nothing moves for a reader who has
     asked for less motion. Both paths land on the finished state immediately. */
  html:not(.js) [data-hero] .hero-word,
  html:not(.js) [data-hero] [data-hero-item] {
    opacity: 1;
    filter: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero] .hero-word,
    [data-hero] [data-hero-item] {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.classList.contains('hero-play')) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Words carry the stagger; the supporting items follow behind the last word so
    // the headline always finishes first. Set here rather than in CSS because the
    // word count depends on the copy.
    const words = hero.querySelectorAll<HTMLElement>('.hero-word');
    words.forEach((word, index) => {
      word.style.transitionDelay = `${index * 55}ms`;
    });

    const headlineDone = words.length * 55 + 220;
    hero.querySelectorAll<HTMLElement>('[data-hero-item]').forEach((item) => {
      const order = Number(item.dataset.heroItem ?? '0');
      item.style.transitionDelay = `${headlineDone + order * 70}ms`;
    });

    if (reduce) {
      hero.classList.add('hero-play');
    } else {
      // Wait for the display face before revealing: a headline that swaps typeface
      // mid-animation is worse than one that starts 40ms later.
      const fonts = document.fonts?.ready ?? Promise.resolve();
      fonts.then(() => requestAnimationFrame(() => hero.classList.add('hero-play')));
      // Never let a font that fails to load leave the hero invisible.
      setTimeout(() => hero.classList.add('hero-play'), 900);
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
