---
import Section from './Section.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  roles: CollectionEntry<'experience'>[];
}

const { roles } = Astro.props;
---

<Section id="experience" eyebrow="Experience" title="Where I have been">
  <ol class="relative">
    {
      roles.map((entry, index) => (
        <li
          class="reveal relative border-l border-[var(--border-subtle)] pb-12 pl-8 last:pb-0"
          style={`transition-delay: ${index * 70}ms`}
        >
          <span
            class="absolute top-1.5 -left-[4.5px] size-2 rounded-full bg-[var(--accent)]"
            aria-hidden="true"
          />

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-lg font-semibold tracking-tight">{entry.data.role}</h3>
            <span class="font-mono text-xs text-[var(--text-muted)]">{entry.data.period}</span>
          </div>

          <p class="mt-1 text-[var(--text-secondary)]">
            {entry.data.org}
            <span class="text-[var(--text-muted)]"> &middot; {entry.data.location}</span>
          </p>

          <ul class="mt-4 space-y-2">
            {entry.data.points.map((point) => (
              <li class="flex gap-3 text-sm text-[var(--text-secondary)]">
                <span
                  class="mt-2 size-1 shrink-0 rounded-full bg-[var(--border-strong)]"
                  aria-hidden="true"
                />
                {point}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
