---
import { profile } from '../data/profile';
import { REPO_URL } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-subtle)] py-10">
  <div
    class="container-page flex flex-col items-start justify-between gap-4 text-sm text-[var(--text-muted)] sm:flex-row sm:items-center"
  >
    <p class="font-mono text-xs">
      &copy; {year} {profile.fullDisplayName} &middot; {profile.location}
    </p>

    <p class="font-mono text-xs">
      Built with Astro, React and Tailwind.
      <a
        href={REPO_URL}
        class="link-underline"
        rel="noopener">Source</a
      >.
    </p>
  </div>
</footer>
