---
import { profile } from '../data/profile';
import { REPO_URL } from '../data/site';
import Instrument from './Instrument.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-subtle)] py-12">
  <div class="container-page">
    <Instrument variant="full" />

    <div
      class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-[var(--border-subtle)] pt-8 text-sm text-[var(--text-muted)] sm:flex-row sm:items-center"
    >
      <p class="datum">
        &copy; {year} {profile.fullDisplayName} &middot; {profile.location}
      </p>

      <p class="datum">
        Built with Astro, React and Tailwind.{' '}
        <a
          href={REPO_URL}
          class="link-underline"
          rel="noopener">Source</a
        >.
      </p>
    </div>
  </div>
</footer>
