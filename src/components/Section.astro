---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  class?: string;
}

const { id, eyebrow, title, lede, class: className = '' } = Astro.props;
---

<section id={id} class={`border-t border-[var(--border-subtle)] py-20 sm:py-28 ${className}`}>
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-title font-semibold tracking-[-0.015em]">
        {title}
      </h2>
      {lede && <p class="text-lede mt-4 text-[var(--text-secondary)]">{lede}</p>}
    </div>

    <div class="mt-12 sm:mt-16">
      <slot />
    </div>
  </div>
</section>
