---
import { Image } from 'astro:assets';
import nowPlaying from '../data/now-playing.json';

/**
 * What Leo is listening to, and the site's only source of colour that is not amber.
 *
 * Lives in the header beside the theme toggle rather than in a section down the page.
 * Buried near the footer it was a few lines of small text that any visitor would
 * scroll straight past; in the chrome it reads as a control the site intends you to
 * find, it is present on every page, and it does not compete with the thesis for the
 * first screen.
 *
 * Everything expensive already happened in the Action: the artwork is local and
 * pre-sized, the vivid colour was extracted with sharp, and both contrast-safe
 * variants were computed against this site's real surfaces. What ships here is a
 * toggle and a handful of CSS variable writes.
 *
 * Renders nothing at all until the Action has run, so the header is correct before
 * Spotify is connected rather than showing a dead button.
 */
const track = nowPlaying.track as {
  title: string;
  artist: string;
  album: string;
  href: string | null;
  live: boolean;
  art: string | null;
  palette: { raw: string; onLight: string; onDark: string } | null;
} | null;

const artwork = track?.art
  ? Object.entries(
      import.meta.glob<{ default: ImageMetadata }>('../assets/now-playing.jpg', { eager: true }),
    )[0]?.[1]?.default
  : undefined;

/**
 * The embed needs the Spotify track id. Newer fetches write it directly; older
 * JSON only has the share URL, so fall back to parsing it out.
 */
const trackId = track?.href?.match(/\/track\/([A-Za-z0-9]+)/)?.[1] ?? null;
---

{
  /*
    transition:persist keeps this exact DOM subtree alive across view transitions.
    Without it, ClientRouter would swap the header on every navigation and destroy
    the Spotify iframe mid-note; with it, the music keeps playing while the rest of
    the page morphs around it. The script guards against re-binding, because the
    persisted node keeps its listeners.
  */
  track && (
    <div
      class="np relative"
      data-now-playing
      transition:persist="now-playing"
      data-track-id={trackId}
      data-on-light={track.palette?.onLight}
      data-on-dark={track.palette?.onDark}
    >
      <button
        type="button"
        data-np-trigger
        aria-expanded="false"
        aria-controls="np-panel"
        class="relative flex size-9 items-center justify-center rounded-md border border-[var(--border-strong)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        {/* Two notes rather than a single one: a lone quaver reads as a generic
            "audio" glyph, a beamed pair reads as music. */}
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
          <path d="M6 12.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm7-1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
          <path d="M5 12.5V4.9l7-1.4V11h1V2.3L4 4.1v8.4h1Z" />
        </svg>
        <span class="sr-only">
          {track.live ? 'Now playing' : 'Recently played'}: {track.title} by {track.artist}
        </span>
        {/* A live track gets a pulse, so the button says "there is something new in
            here" without needing a label. */}
        {track.live && (
          <span
            class="np-live absolute -top-0.5 -right-0.5 size-2 rounded-full bg-[var(--accent)]"
            aria-hidden="true"
          />
        )}
      </button>

      <div
        id="np-panel"
        data-np-panel
        hidden
        class="np-panel absolute top-[calc(100%+0.5rem)] right-0 z-50 w-[19rem] rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-4 shadow-2xl"
      >
        <p class="eyebrow mb-3">{track.live ? 'Listening right now' : 'Last listened to'}</p>

        <div class="flex items-start gap-3">
          {artwork && (
            <Image
              src={artwork}
              alt={`${track.album} album art`}
              width={64}
              height={64}
              loading="lazy"
              class="size-16 shrink-0 rounded-md border border-[var(--border-subtle)]"
            />
          )}

          <div class="min-w-0 flex-1">
            <p class="leading-snug font-medium">
              {track.href ? (
                <a href={track.href} class="link-underline" target="_blank" rel="noopener noreferrer">
                  {track.title}
                </a>
              ) : (
                track.title
              )}
            </p>
            <p class="datum mt-1 truncate">{track.artist}</p>
          </div>
        </div>

        {track.palette ? (
          <button
            type="button"
            data-tint-toggle
            aria-pressed="false"
            class="mt-4 flex w-full items-center justify-between gap-3 rounded-lg border border-[var(--border-strong)] px-3 py-2.5 text-sm font-medium transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            <span data-tint-label>Use this palette</span>
            <span
              class="size-4 shrink-0 rounded-full border border-[var(--border-subtle)]"
              style={`background-color: ${track.palette.raw}`}
              aria-hidden="true"
            />
          </button>
        ) : (
          /* The extractor found no colour worth borrowing, so say so rather than
             offering a button that would turn the site grey. */
          <p class="datum mt-4 leading-relaxed text-[var(--text-muted)]">
            This cover has no colour worth borrowing, so the site keeps its amber.
          </p>
        )}

        {/*
          Our own transport, not Spotify's card.

          Their embed renders its own art, title and artist, so dropping it in here
          repeated everything above it in a different visual language: green on dark
          inside a warm ink panel. This is the same controls in our own type and
          tokens, driven by Spotify's iframe API. The iframe itself still does the
          audio, off-screen, because that is the only lawful way to play the track.
        */}
        {trackId && (
          <div data-np-player hidden class="mt-4 border-t border-[var(--border-subtle)] pt-4">
            <div class="flex items-center gap-3">
              <button
                type="button"
                data-np-playpause
                aria-label="Play preview"
                class="flex size-10 shrink-0 items-center justify-center rounded-full border border-[var(--border-strong)] text-[var(--text-primary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
              >
                <svg data-np-icon-play viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
                  <path d="M5 3.5v9l7.5-4.5L5 3.5Z" />
                </svg>
                <svg
                  data-np-icon-pause
                  viewBox="0 0 16 16"
                  class="hidden size-4"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M5 3.5h2.2v9H5v-9Zm3.8 0H11v9H8.8v-9Z" />
                </svg>
              </button>

              <div class="min-w-0 flex-1">
                {/* Scrubbable: a progress bar you cannot seek with is a decoration. */}
                <div
                  data-np-scrub
                  role="slider"
                  tabindex="0"
                  aria-label="Seek within preview"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                  class="np-scrub group/scrub relative flex h-4 w-full cursor-pointer items-center"
                >
                  <span class="h-0.5 w-full rounded-full bg-[var(--border-subtle)]">
                    <span
                      data-np-progress
                      class="block h-0.5 w-0 rounded-full bg-[var(--accent)]"
                    />
                  </span>
                  <span
                    data-np-thumb
                    class="pointer-events-none absolute size-2.5 -translate-x-1/2 rounded-full bg-[var(--accent)] opacity-0 transition-opacity group-hover/scrub:opacity-100"
                    style="left: 0%"
                    aria-hidden="true"
                  />
                </div>

                {/* Dashes, not 0:00 / 0:30. The length is whatever Spotify reports
                    (30s preview, or the full track for a signed-in listener), so
                    printing a duration before being told one would be a guess. */}
                <p class="datum mt-1.5 flex items-center justify-between gap-2">
                  <span data-np-time class="tnum">&ndash;:&ndash;&ndash;</span>
                  <span data-np-duration class="tnum text-[var(--text-muted)]">&ndash;:&ndash;&ndash;</span>
                </p>
              </div>
            </div>

            {/* Attribution stays visible: the audio is theirs, and their guidelines
                expect the source named and linkable. */}
            <p class="datum mt-3 flex flex-wrap items-center gap-x-2 text-[var(--text-muted)]">
              <span data-np-state>Connecting&hellip;</span>
              <span class="text-[var(--border-strong)]" aria-hidden="true">·</span>
              {track.href ? (
                <a href={track.href} class="link-underline" target="_blank" rel="noopener noreferrer">
                  via Spotify
                </a>
              ) : (
                <span>via Spotify</span>
              )}
            </p>
          </div>
        )}

        {/*
          The audio engine. Positioned off-screen rather than display:none, because a
          display:none iframe can have its media suspended by the browser. Loaded only
          when a visitor asks for music, so the one third-party connection on this site
          costs nothing until consented to.
        */}
        {trackId && (
          <div data-np-embed-mount class="np-engine" aria-hidden="true">
            <div data-np-embed />
          </div>
        )}
      </div>

      {/* First-visit invitation. Deliberately not a gate: the page is fully usable
          behind it, it arrives after the thesis has landed, and either answer is
          remembered so it never appears twice. */}
      {trackId && (
        <div
          data-np-prompt
          hidden
          role="region"
          aria-label="Soundtrack offer"
          class="np-prompt fixed top-20 right-4 z-50 w-80 max-w-[calc(100vw-2rem)] rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-4 shadow-2xl"
        >
          <p class="eyebrow">This site has a soundtrack</p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            {track.title} — {track.artist}. Want it while you read? It brings the
            album's colours with it.
          </p>
          <div class="mt-3 flex items-center gap-2">
            <button
              type="button"
              data-vibes-yes
              class="rounded-lg bg-[var(--text-primary)] px-4 py-2 text-sm font-medium text-[var(--surface)] transition-opacity hover:opacity-88"
            >
              Play the vibes
            </button>
            <button
              type="button"
              data-vibes-no
              class="rounded-lg border border-[var(--border-strong)] px-4 py-2 text-sm font-medium transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
            >
              Keep it quiet
            </button>
          </div>
          <p class="datum mt-3 text-[var(--text-muted)]">
            Spotify preview · remembered on this device
          </p>
        </div>
      )}
    </div>
  )
}

<style>
  .np-panel {
    transform-origin: top right;
  }

  /* Spotify's iframe, kept for audio only. Off-screen at real size rather than
     display:none or 1px, both of which let browsers suspend or refuse media
     playback. Never focusable, never in the tab order. */
  .np-engine {
    position: fixed;
    left: -10000px;
    top: 0;
    width: 320px;
    height: 80px;
    opacity: 0;
    pointer-events: none;
  }

  /* Widen the hit area without changing the visual weight of the 2px track. */
  .np-scrub::before {
    content: '';
    position: absolute;
    inset: -6px 0;
  }

  .np-panel:not([hidden]) {
    animation: np-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes np-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }

  /* Slow enough to read as a heartbeat rather than a notification badge demanding
     attention. */
  .np-live {
    animation: np-pulse 2.4s ease-in-out infinite;
  }

  @keyframes np-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-panel:not([hidden]),
    .np-live {
      animation: none;
    }
  }

  .np-prompt:not([hidden]) {
    animation: np-prompt-in 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes np-prompt-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-prompt:not([hidden]) {
      animation: none;
    }
  }

  /* The tint overrides the same semantic tokens the whole site reads, so one
     attribute on <html> repaints every accent and surface at once and no component
     needs to know it happened. */
  :global(html[data-tinted]) {
    --accent: var(--tint-accent);
    --accent-bright: var(--tint-accent);
    --surface: color-mix(in srgb, var(--tint-accent) 4%, var(--color-ink-50));
    --surface-raised: color-mix(in srgb, var(--tint-accent) 2%, #ffffff);
    --surface-sunken: color-mix(in srgb, var(--tint-accent) 7%, var(--color-ink-100));
  }

  :global(html.dark[data-tinted]) {
    --surface: color-mix(in srgb, var(--tint-accent) 6%, var(--color-ink-950));
    --surface-raised: color-mix(in srgb, var(--tint-accent) 9%, var(--color-ink-900));
    --surface-sunken: color-mix(in srgb, var(--tint-accent) 4%, #080807);
  }

  /* Surfaces cross-fade rather than snapping, which is what makes one small button
     feel like it did something large. Text colour is left alone so nothing becomes
     briefly unreadable mid-transition. */
  :global(html[data-tint-animate] body),
  :global(html[data-tint-animate] body *) {
    transition:
      background-color 420ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-tint-animate] body),
    :global(html[data-tint-animate] body *) {
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'tint';

  function applyTint(on: boolean, root_: HTMLElement) {
    const root = document.documentElement;
    const accent = root.classList.contains('dark')
      ? root_.dataset.onDark
      : root_.dataset.onLight;
    if (!accent) return;

    root.style.setProperty('--tint-accent', accent);
    root.toggleAttribute('data-tinted', on);

    /**
     * Published so the pre-paint script in Layout can restore the tint after a view
     * transition without waiting for this module. ClientRouter wipes the inline
     * --tint-accent along with the rest of the <html> attributes, and reading it back
     * from the DOM would mean a visible flash of amber first.
     */
    try {
      if (root_.dataset.onLight) localStorage.setItem('tintLight', root_.dataset.onLight);
      if (root_.dataset.onDark) localStorage.setItem('tintDark', root_.dataset.onDark);
    } catch {
      /* Private mode. The tint still works for this page view. */
    }

    root_.querySelector('[data-tint-toggle]')?.setAttribute('aria-pressed', String(on));
    const label = root_.querySelector<HTMLElement>('[data-tint-label]');
    if (label) label.textContent = on ? 'Back to amber' : 'Use this palette';
  }

  const VIBES_KEY = 'vibes';

  interface SpotifyController {
    play: () => void;
    togglePlay: () => void;
    seek: (seconds: number) => void;
    addListener: (event: string, cb: (e: { data: PlaybackData }) => void) => void;
  }
  interface PlaybackData {
    isPaused: boolean;
    isBuffering: boolean;
    duration: number;
    position: number;
  }

  /** Survives navigations along with the transition:persist node. */
  let embedController: SpotifyController | null = null;
  /** 0 until Spotify reports a real length, so nothing is invented. */
  let lastDuration = 0;

  const mmss = (ms: number) => {
    const total = Math.max(0, Math.round(ms / 1000));
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
  };

  /** Paints our own transport from Spotify's playback events. */
  function renderPlayback(wrap: HTMLElement, data: PlaybackData) {
    if (data.duration) lastDuration = data.duration;
    const ratio = lastDuration ? Math.min(data.position / lastDuration, 1) : 0;

    const fill = wrap.querySelector<HTMLElement>('[data-np-progress]');
    const thumb = wrap.querySelector<HTMLElement>('[data-np-thumb]');
    const scrub = wrap.querySelector<HTMLElement>('[data-np-scrub]');
    if (fill) fill.style.width = `${(ratio * 100).toFixed(2)}%`;
    if (thumb) thumb.style.left = `${(ratio * 100).toFixed(2)}%`;
    scrub?.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));

    const time = wrap.querySelector<HTMLElement>('[data-np-time]');
    const dur = wrap.querySelector<HTMLElement>('[data-np-duration]');
    if (time) time.textContent = lastDuration ? mmss(data.position) : '–:––';
    if (dur) dur.textContent = lastDuration ? mmss(lastDuration) : '–:––';

    /**
     * Icon shows what the button will DO next, which is the convention.
     * Toggles the `hidden` class, not the attribute: the markup uses Tailwind's
     * hidden utility and an attribute would not have overridden that class.
     */
    const playIcon = wrap.querySelector<HTMLElement>('[data-np-icon-play]');
    const pauseIcon = wrap.querySelector<HTMLElement>('[data-np-icon-pause]');
    const button = wrap.querySelector<HTMLElement>('[data-np-playpause]');
    playIcon?.classList.toggle('hidden', !data.isPaused);
    pauseIcon?.classList.toggle('hidden', data.isPaused);
    button?.setAttribute('aria-label', data.isPaused ? 'Play preview' : 'Pause preview');

    /**
     * "Preview" vs "Full track" is inferred from the length Spotify hands back: an
     * anonymous listener gets 30 seconds, a signed-in one gets the whole thing. Only
     * claimed once a real duration has arrived.
     */
    const state = wrap.querySelector<HTMLElement>('[data-np-state]');
    if (state) {
      state.textContent = data.isBuffering
        ? 'Buffering…'
        : !lastDuration
          ? 'Connecting…'
          : lastDuration > 45000
            ? 'Full track'
            : 'Preview';
    }
  }

  function loadEmbed(wrap: HTMLElement, autoplay: boolean) {
    if (embedController) {
      if (autoplay) embedController.play();
      return;
    }

    const target = wrap.querySelector<HTMLElement>('[data-np-embed]');
    const player = wrap.querySelector<HTMLElement>('[data-np-player]');
    const trackId = wrap.dataset.trackId;
    if (!target || !trackId) return;

    player?.removeAttribute('hidden');

    // Spotify's loader calls this global once its API is ready.
    (window as any).onSpotifyIframeApiReady = (api: any) => {
      api.createController(
        target,
        { uri: `spotify:track:${trackId}`, width: 320, height: 80 },
        (controller: SpotifyController) => {
          embedController = controller;
          controller.addListener('playback_update', (event) =>
            renderPlayback(wrap, event.data),
          );
          if (autoplay) controller.play();
        },
      );
    };

    const loader = document.createElement('script');
    loader.src = 'https://open.spotify.com/embed/iframe-api/v1';
    loader.async = true;
    document.head.append(loader);
  }

  /** Wires our transport. Called once; the controller may not exist yet. */
  function bindTransport(wrap: HTMLElement) {
    wrap.querySelector('[data-np-playpause]')?.addEventListener('click', () => {
      // First press doubles as the gesture that loads and starts the engine.
      if (!embedController) loadEmbed(wrap, true);
      else embedController.togglePlay();
    });

    const scrub = wrap.querySelector<HTMLElement>('[data-np-scrub]');
    if (!scrub) return;

    const seekTo = (clientX: number) => {
      // Seeking before a duration is known would send seek(NaN).
      if (!embedController || !lastDuration) return;
      const rect = scrub.getBoundingClientRect();
      const ratio = Math.min(Math.max((clientX - rect.left) / rect.width, 0), 1);
      embedController.seek((ratio * lastDuration) / 1000);
    };

    scrub.addEventListener('pointerdown', (event) => {
      seekTo(event.clientX);
      // Dragging past the bar keeps scrubbing until release.
      const move = (e: PointerEvent) => seekTo(e.clientX);
      const up = () => {
        window.removeEventListener('pointermove', move);
        window.removeEventListener('pointerup', up);
      };
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', up);
    });

    // Keyboard seeking, because a slider role promises arrow keys work.
    scrub.addEventListener('keydown', (event) => {
      if (!embedController || !lastDuration) return;
      const step = event.key === 'ArrowRight' ? 5 : event.key === 'ArrowLeft' ? -5 : 0;
      if (!step) return;
      event.preventDefault();
      const current = Number(scrub.getAttribute('aria-valuenow') ?? '0') / 100;
      embedController.seek(Math.max(0, current * (lastDuration / 1000) + step));
    });
  }

  /** Current tint state, kept at module scope so it survives navigations. */
  let tintOn = false;

  function initNowPlaying() {
    const wrap = document.querySelector<HTMLElement>('[data-now-playing]');
    if (!wrap) return;

    /**
     * transition:persist carries this node with its listeners, so binding must happen
     * once. Re-applying the tint must happen EVERY time though: ClientRouter wipes
     * data-tinted off <html>, and the old early return meant the palette silently
     * reverted to amber on the first navigation.
     */
    if (wrap.dataset.bound) {
      applyTint(tintOn, wrap);
      return;
    }
    wrap.dataset.bound = '1';

    const trigger = wrap.querySelector<HTMLButtonElement>('[data-np-trigger]')!;
    const panel = wrap.querySelector<HTMLElement>('[data-np-panel]')!;
    const root = document.documentElement;

    function setOpen(open: boolean) {
      panel.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    }

    trigger.addEventListener('click', () => setOpen(panel.hidden));

    // Light dismiss. Hand-rolled rather than using the popover attribute so the
    // behaviour is identical on every browser that can run the rest of this site.
    document.addEventListener('click', (event) => {
      if (!panel.hidden && !wrap.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });

    try {
      tintOn = localStorage.getItem(STORAGE_KEY) === '1';
    } catch {
      /* Private mode can throw. Off is the right default. */
    }

    // Restore without animating: a returning visitor should not watch the page fade
    // into a colour it was always going to be.
    applyTint(tintOn, wrap);

    wrap.querySelector('[data-tint-toggle]')?.addEventListener('click', () => {
      tintOn = !tintOn;
      root.setAttribute('data-tint-animate', '');
      applyTint(tintOn, wrap);
      try {
        localStorage.setItem(STORAGE_KEY, tintOn ? '1' : '0');
      } catch {
        /* Not worth failing the interaction over. */
      }
    });

    /**
     * The accent has a separate contrast-safe value per theme, so it has to be
     * recomputed when the theme flips. Listens for the event ThemeToggle dispatches
     * rather than binding to #theme-toggle: that button lives in the swapped region
     * and the old direct binding pointed at a dead element after any navigation.
     */
    document.addEventListener('theme:changed', () =>
      requestAnimationFrame(() => applyTint(tintOn, wrap)),
    );

    /* ---- The soundtrack. ---- */

    bindTransport(wrap);

    const prompt = wrap.querySelector<HTMLElement>('[data-np-prompt]');
    let vibes: string | null = null;
    try {
      vibes = localStorage.getItem(VIBES_KEY);
    } catch {
      /* Private mode. Treat as answered so the prompt cannot nag. */
      vibes = '0';
    }

    const remember = (value: string) => {
      try {
        localStorage.setItem(VIBES_KEY, value);
      } catch {
        /* Fine: the choice just will not persist. */
      }
    };

    if (prompt && vibes === null) {
      // After the thesis has landed, not against it.
      setTimeout(() => {
        prompt.hidden = false;
      }, 1100);

      prompt.querySelector('[data-vibes-yes]')?.addEventListener('click', () => {
        prompt.hidden = true;
        remember('1');
        // Vibes means both: the music and the album's colours, one choice.
        if (!tintOn && wrap.dataset.onLight) {
          tintOn = true;
          root.setAttribute('data-tint-animate', '');
          applyTint(true, wrap);
          try {
            localStorage.setItem(STORAGE_KEY, '1');
          } catch {
            /* Fine. */
          }
        }
        setOpen(true);
        // The click IS the user gesture autoplay policy requires.
        loadEmbed(wrap, true);
      });

      prompt.querySelector('[data-vibes-no]')?.addEventListener('click', () => {
        prompt.hidden = true;
        remember('0');
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && prompt && !prompt.hidden) prompt.hidden = true;
      });
    } else if (vibes === '1') {
      /**
       * A returning vibes-visitor cannot get autoplay: browsers require a user
       * gesture per page load, full stop. The nearest legal thing is to resume on
       * their first interaction with the page, which is what they opted into.
       */
      const resume = () => loadEmbed(wrap, true);
      document.addEventListener('pointerdown', resume, { once: true });
    }
  }

  document.addEventListener('astro:page-load', initNowPlaying);
</script>
