---
import Section from './Section.astro';
import { profile } from '../data/profile';
---

<Section
  id="skills"
  eyebrow="Skills"
  title="What I work with"
  lede="Grouped honestly. The things I have shipped production code in are in the first two groups; the rest is where I am genuinely capable rather than merely familiar."
>
  <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {
      profile.skills.map((group, index) => (
        <div class="reveal" style={`transition-delay: ${index * 70}ms`}>
          <div class="flex items-baseline gap-3 border-b border-[var(--border-subtle)] pb-3">
            <h3 class="font-mono text-sm font-medium tracking-tight text-[var(--accent)]">
              {group.label}
            </h3>
            <span class="font-mono text-xs text-[var(--text-muted)]">{group.items.length}</span>
          </div>

          <p class="mt-3 text-sm text-[var(--text-muted)]">{group.note}</p>

          <ul class="mt-4 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="rounded-md border border-[var(--border-subtle)] px-2.5 py-1 font-mono text-xs text-[var(--text-secondary)]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
