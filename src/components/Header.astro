---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  subpage?: boolean;
}

const { subpage = false } = Astro.props;
const prefix = subpage ? '/' : '';

/**
 * Work and Trajectory are anchors on the home page; About is its own route now.
 * Skills moved to /about, so linking it here would have sent people to a section
 * that no longer exists on whichever page they were standing on.
 */
const links = [
  { label: 'Work', href: `${prefix}#work` },
  { label: 'Trajectory', href: `${prefix}#timeline` },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: `${prefix}#contact` },
];
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border-subtle)] bg-[color-mix(in_srgb,var(--surface)_88%,transparent)] backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="font-mono text-sm font-medium tracking-tight transition-colors hover:text-[var(--accent)]"
      aria-label={`${profile.displayName}, home`}
    >
      <span class="text-[var(--accent)]">~/</span>{profile.displayName.toLowerCase().replace(' ', '-')}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="Sections" class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded-md px-3 py-2 text-sm text-[var(--text-secondary)] transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text-primary)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!--
        A keyboard shortcut nobody can discover is worth nothing, so the palette
        gets a visible, clickable affordance that also states its shortcut.
      -->
      <button
        type="button"
        data-palette-open
        class="flex items-center gap-2 rounded-md border border-[var(--border-strong)] px-2.5 py-1.5 font-mono text-xs tracking-wide transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        aria-haspopup="dialog"
      >
        <span aria-hidden="true">&#8984;K</span>
        <span class="sr-only">Open command palette</span>
      </button>

      <!--
        Opens the CV in a window rather than downloading. Still a real anchor to the
        PDF, so middle-click, right-click-save and a no-JS visitor all keep working;
        the script only intercepts the plain click.

        prefetchAll treats the CV as an internal link and was fetching the whole PDF
        on every page load, for every visitor, most of whom never download it. The
        site publishes its own page weight, so spending bytes on a file nobody asked
        for is not a thing it can do.
      -->
      <a
        href={profile.resume}
        data-cv-open
        aria-haspopup="dialog"
        class="rounded-md border border-[var(--border-strong)] px-3 py-1.5 font-mono text-xs tracking-wide transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        data-astro-prefetch="false"
      >
        CV
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>
