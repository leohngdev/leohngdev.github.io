---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
import NowPlaying from './NowPlaying.astro';
interface Props { subpage?: boolean }
const { subpage = false } = Astro.props;
const prefix = subpage ? '/' : '';
---
<header class="site-header">
  <div class="container-page header-inner">
    <a href="/" class="site-brand" aria-label={`${profile.displayName}, home`}>
      LEO NGUYEN<span>SOFTWARE DEVELOPER / MELBOURNE</span>
    </a>
    <nav aria-label="Main navigation" class="site-nav">
      <a href={`${prefix}#work`}>Work</a>
      <a href={`${prefix}#about`}>About</a>
      <a href={`${prefix}#contact`}>Contact</a>
      <a href={profile.resume} data-cv-open data-astro-prefetch="false" aria-haspopup="dialog" class="nav-cv">CV ↗</a>
    </nav>
    <div class="header-controls">
      <button type="button" data-palette-open aria-haspopup="dialog" class="palette-trigger"><span aria-hidden="true">⌘K</span><span class="sr-only">Open command palette</span></button>
      <NowPlaying />
      <ThemeToggle />
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--border-subtle); background: var(--surface); }
  .header-inner { min-height: 80px; display: flex; align-items: center; gap: 24px; }
  .site-brand { font: 600 26px/1 var(--font-display); text-decoration: none; white-space: nowrap; margin-right: auto; }
  .site-brand span { display: block; font: 500 9px/1.4 var(--font-sans); letter-spacing: .06em; margin-top: 7px; }
  .site-nav { display: flex; gap: 22px; align-items: center; }
  .site-nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; text-underline-offset: 5px; }
  .site-nav a:hover { text-decoration: underline; }
  .nav-cv { font-weight: 600; }
  .header-controls { display: flex; align-items: center; gap: 4px; }
  :global(html:not(.js)) .header-controls { display: none; }
  .header-controls :global(button) { min-width: 40px; min-height: 44px; }
  .palette-trigger { min-height: 44px; min-width: 44px; font-size: 13px; cursor: pointer; }
  @media (max-width: 760px) {
    .header-inner { padding-block: 12px 0; gap: 0; flex-wrap: wrap; }
    .site-brand { font-size: 23px; }
    .site-brand span { font-size: 8px; }
    .site-nav { order: 3; width: 100%; justify-content: space-between; gap: 16px; }
    .site-nav a { font-size: 12px; }
    .palette-trigger { font-size: 12px; min-width: 32px; }
    .header-controls { gap: 0; }
  }
</style>
