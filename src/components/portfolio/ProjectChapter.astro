---
import type { CollectionEntry } from 'astro:content';
import { portfolio } from '../../data/portfolio';
import ProjectObject from './ProjectObject.astro';
interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const { data } = project;
const item = portfolio[project.id];
const { key } = item;
const reversed = ['antsa', 'character', 'robotics'].includes(key);
---
<article class:list={['chapter', key, { 'chapter-reversed': reversed }]} id={key} data-motion="project" aria-labelledby={`${key}-title`}>
  <header class="chapter-head"><span class="eyebrow">{String(index + 1).padStart(2, '0')} / {item.label}</span><span class="date">{data.period}</span></header>
  <div class="chapter-grid">
    <div class="chapter-copy">
      <h2 id={`${key}-title`} transition:name={`title-${project.id}`}>{item.title}</h2>
      <p class="lede">{item.lede}</p>
      <p class="body-copy">{data.summary}</p>
      <p class="role-line">{data.role}{data.org && <> · {data.org.replace(' — ', ' / ')}</>}</p>
      <h3>{key === 'yard' ? 'What I built' : 'My contribution'}</h3>
      <ul class="facts">{data.highlights.map(point => <li>{point}</li>)}</ul>
      {item.takeaway && <><h3>{item.takeaway.title}</h3><p class="takeaway">{item.takeaway.text}</p></>}
      <p class="tools">{data.stack.join(' · ')}</p>
      <a class="text-link" href={`/work/${project.id}/`}>Read the full {key === 'yard' || key === 'antsa' ? 'case study' : 'project notes'} ↗</a>
      {data.links.map(link => <a class="text-link secondary-link" href={link.href} rel="noopener noreferrer" target="_blank">{key === 'yard' ? 'Public showcase' : link.label} ↗</a>)}
    </div>
    <div class="prop-column">
      <div class:list={{ 'yard-visual': key === 'yard' }}>
        {key === 'yard' && <figure class="phone-print"><span class="tape a" aria-hidden="true"></span><img src="/media/loose-parts/yard-map.webp" alt="Yard's neighbourhood map screen from the public project showcase." width="1080" height="2400" loading="lazy" decoding="async" /><figcaption>From the Yard showcase</figcaption></figure>}
        <div class="prop-area">
          <a href={`#${key}-notes`} class:list={['prop-button', { 'rule-folder': key === 'antsa', 'mesh-page': key === 'character' }]} data-notes={key} aria-controls={`${key}-notes`} aria-label={`Open ${item.short} project notes`}>
            <ProjectObject kind={key} expanded />
            <span class="hand" aria-hidden="true">{item.annotation} {key === 'yard' && '↗'}</span>
          </a>
        </div>
      </div>
      {key === 'yard' && <><span class="margin-note">the boundary is part<br />of the product.</span><p class="status-note">As documented 30 September 2026: TestFlight beta, submitted for App Store review. Public showcase; source code is private.</p></>}
      {key === 'antsa' && <div class="evidence"><div class="stamp"><strong>100%</strong><span>CLIENT UAT</span></div><p>Pass rate across two<br />client-signed iterations.</p></div>}
      {item.diagram && <div class="diagram-strip" aria-label={item.diagram.join(', then ')}>{item.diagram.map((step, i) => <>{i > 0 && <b aria-hidden="true">→</b>}<span>{step}</span></>)}</div>}
    </div>
  </div>
  <details class="extras" id={`${key}-notes`}><summary>{item.notesTitle}</summary><div class="insert"><span class="tape a" aria-hidden="true"></span>{item.notes.map(note => <p>{note}</p>)}<a class="text-link" href={`/work/${project.id}/`}>Continue to the full story ↗</a></div></details>
</article>
