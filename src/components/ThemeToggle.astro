<button
  type="button"
  id="theme-toggle"
  class="rounded-md p-2 text-[var(--text-secondary)] transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text-primary)]"
  aria-label="Toggle colour theme"
  aria-pressed="false"
>
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
  </svg>
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z" />
  </svg>
</button>

<script>
  /**
   * Delegated on `document` rather than bound to the button.
   *
   * The header is inside the swapped region, so a listener attached directly to
   * #theme-toggle pointed at an element that no longer existed after the first view
   * transition: the toggle silently stopped working on every page you navigated to.
   * `document` survives navigation, so one delegated listener keeps working.
   */
  const root = document.documentElement;

  function syncPressed() {
    document
      .getElementById('theme-toggle')
      ?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  }

  // Module scope is not enough: a re-executed module would double-bind.
  const flag = '__themeToggleBound' as const;
  const w = window as unknown as Record<string, boolean>;

  if (!w[flag]) {
    w[flag] = true;

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target?.closest('#theme-toggle')) return;

      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        /* Persisting the choice is a nicety, not a requirement. */
      }
      syncPressed();
      // The tint has a separate contrast-safe colour per theme.
      document.dispatchEvent(new CustomEvent('theme:changed'));
    });
  }

  // The new button arrives with aria-pressed="false" from the server on every swap.
  document.addEventListener('astro:page-load', syncPressed);
</script>
