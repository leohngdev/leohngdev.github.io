---
import Layout from '~/layouts/Layout.astro';
import RoomSpine from '~/components/house/RoomSpine.astro';
import { rooms } from '~/data/house';

/**
 * The house, under construction. The live site at / is untouched until Phase 4.
 *
 * The markup below is authored first and is the source of truth for content. The
 * three.js layer in src/lib/house/ is dynamically imported over the top of it, only
 * when WebGL is available and motion is not reduced.
 */
---

<Layout title="The House" description="A portfolio you walk around in. Under construction." subpage>
  <div id="house-stage" class="house-stage" data-house-state="spine">
    <div class="house-spine">
      <h1 class="house-spine__title">The House</h1>
      <p class="house-spine__intro">
        Six rooms, one for each stage of the work. This route is under
        construction. The text below is the whole page for now.
      </p>
      {rooms.map((room) => <RoomSpine room={room}>
        <p>Full case study for {room.title} lands in Phase 2.</p>
      </RoomSpine>)}
    </div>
    <!--
      index.ts finds this by its data attribute and toggles `hidden` as the camera
      state changes. This is static markup, not a runtime-created element, so it
      sits in the accessibility tree and the tab order from the first paint, well
      before the scene finishes mounting. A phone visitor pushed into a room has
      no Escape key and no empty canvas area left to tap once cover-fit fills the
      frame, so this button is the only discoverable way out.
    -->
    <button type="button" class="house-back" data-house-back hidden>
      Back to overview
    </button>
  </div>
</Layout>

<style>
  /* Greybox styling only. Phase 1 replaces this wholesale. */
  .house-stage { position: relative; min-height: 100svh; }
  .house-spine { max-width: 46rem; margin: 0 auto; padding: 4rem 1.5rem; }
  .house-spine__title { font-family: var(--font-display); font-size: 2.5rem; }
  .house-spine__intro { max-width: 34rem; margin-top: 0.75rem; color: var(--text-muted); }

  /*
   * Once index.ts mounts the scene it flips data-house-state to "scene". Pin the
   * stage to one viewport-height box and hide its own overflow so the canvas has a
   * real, stable box to size itself against instead of the document's full scroll
   * height (which is what produced a canvas taller than it was wide). svh, not vh,
   * matches the rest of the repo and behaves correctly under mobile browser chrome.
   *
   * Staying in normal document flow here matters: the Footer after this stage in
   * the markup needs #main to keep real height so it stays reachable by scrolling.
   * Below, the phone breakpoint overrides this to fixed positioning for a reason
   * the general case does not share; see that rule for why.
   */
  .house-stage[data-house-state='scene'] {
    height: 100svh;
    overflow: hidden;
  }

  /*
   * The header above this stage is sticky and takes real space in normal flow.
   * On the phone tower, the header's own height plus the stage's full 100svh push
   * the document taller than the viewport, so the last room in the overview sat
   * past the fold until a visitor scrolled to it. Fixed positioning here pins the
   * stage to the true viewport so its one-viewport-height box is the whole visible
   * area no matter what sits above it in the document, which is what actually
   * fixes the clipped room. It only runs below the phone breakpoint: at desktop
   * widths the stage stays in flow (the rule above), because taking it out of
   * flow at every width collapses #main to zero height and buries the Footer
   * under the canvas with no scroll left to reach it. The header's higher z-index
   * keeps it stacked above the canvas even while the stage is fixed.
   *
   * The `width < 768px` range mirrors PHONE_BREAKPOINT in src/lib/house/grid.ts,
   * which columnsFor() tests as `viewportWidth < PHONE_BREAKPOINT`. A max-width
   * query only matches integer pixels at or below its value, so at a fractional
   * width like 767.4 (browser zoom and devicePixelRatio scaling both produce
   * these) the JS would pick the phone layout while a max-width query here
   * declined to pin the stage, reopening the clipped-room bug. Anyone moving
   * PHONE_BREAKPOINT should move this boundary too.
   */
  @media (width < 768px) {
    .house-stage[data-house-state='scene'] {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 0;
      width: 100%;
    }
  }

  /*
   * The canvas is created by scene.ts at runtime and appended to #house-stage, so it
   * never receives this component's data-astro-cid-* scope attribute. Writing
   * "canvas { ... }" here would compile to "canvas[data-astro-cid-xxx]" and match
   * nothing silently, which is the exact dead-rule shape this route already shipped
   * once. :global() is required so the selector reaches an unscoped element.
   */
  :global(.house-stage[data-house-state='scene'] canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /*
   * The spine stays in the DOM and in the accessibility tree once the scene mounts.
   * It is the screen-reader route, the no-WebGL fallback, and the indexable content,
   * so display:none (which pulls it from the accessibility tree) and removing the
   * node are both wrong here. This is the same visually-hidden shape as the sr-only
   * utility used in src/layouts/Layout.astro, written out by hand because this rule
   * only applies conditionally on data-house-state and a utility class can't carry
   * that condition. clip-path is used instead of the deprecated clip: rect(...).
   */
  .house-stage[data-house-state='scene'] .house-spine {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /*
   * The only discoverable way a phone visitor leaves a pushed-in room: no
   * Escape key exists on a phone, and cover-fit leaves no empty canvas area to
   * tap once the camera is in a room. Sitting at the bottom keeps it clear of
   * the sticky header and of the NowPlaying soundtrack card, both of which
   * occupy the top of the viewport. index.ts toggles the `hidden` attribute as
   * the camera state changes; the [hidden] rule below beats the bare class on
   * specificity, so the layout rules here never win and the toggle actually
   * hides the button.
   */
  .house-back {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    z-index: 5;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--text-primary);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .house-back[hidden] {
    display: none;
  }
</style>

<script>
  /**
   * Loads the 3D layer only when it can actually run, and only on this route.
   *
   * Initialises on astro:page-load because ClientRouter is on and module scripts do
   * not re-run after navigation. The guard keeps a second navigation back to /house
   * from mounting two scenes.
   */
  let mounted = false;

  async function mountHouse() {
    const stage = document.getElementById('house-stage');
    if (!stage || mounted) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const probe = document.createElement('canvas');
    const gl = probe.getContext('webgl2');
    if (!gl) return;

    mounted = true;
    const { mountHouseScene } = await import('~/lib/house/index.ts');
    mountHouseScene(stage);
  }

  document.addEventListener('astro:page-load', mountHouse);
</script>
