---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const ordered = [...projects].sort((a, b) => a.data.order - b.data.order);

  return ordered.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      // Precomputed so the footer can offer the next case study.
      next: ordered[(index + 1) % ordered.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const categoryLabels: Record<string, string> = {
  web: 'Web & Backend',
  game: 'Games',
  threed: '3D & Technical Art',
  hardware: 'Robotics',
};
---

<Layout title={`${data.title} — ${profile.displayName}`} description={data.summary} subpage>
  <article class="pt-14 pb-20 sm:pt-20 sm:pb-28">
    <div class="container-page">
      <a
        href="/#work"
        class="inline-flex items-center gap-2 font-mono text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
      >
        <span aria-hidden="true">&#8592;</span>
        All work
      </a>

      <header class="mt-8 max-w-3xl">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="eyebrow">{categoryLabels[data.category] ?? data.category}</span>
          <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
          <span class="font-mono text-xs text-[var(--text-muted)]">{data.period}</span>
        </div>

        <h1 class="text-title mt-4 font-semibold tracking-[-0.015em]">
          {data.title}
        </h1>

        <p class="text-subtitle mt-5 text-[var(--text-secondary)]">{data.tagline}</p>
      </header>

      {
        data.cover && (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? `${data.title}`}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 72rem) 68rem, 100vw"
            class="mt-12 w-full rounded-xl border border-[var(--border-subtle)]"
          />
        )
      }

      <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
        <div class="prose-case prose max-w-none">
          <Content />
        </div>

        <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
          <div>
            <p class="eyebrow">Role</p>
            <p class="mt-2 text-sm">{data.role}</p>
            {data.org && <p class="mt-1 text-sm text-[var(--text-muted)]">{data.org}</p>}
          </div>

          <div>
            <p class="eyebrow">Stack</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {
                data.stack.map((tech) => (
                  <li class="rounded-md border border-[var(--border-subtle)] px-2 py-1 font-mono text-xs text-[var(--text-secondary)]">
                    {tech}
                  </li>
                ))
              }
            </ul>
          </div>

          {
            data.highlights.length > 0 && (
              <div>
                <p class="eyebrow">Outcomes</p>
                <ul class="mt-3 space-y-2.5">
                  {data.highlights.map((highlight) => (
                    <li class="flex gap-2.5 text-sm text-[var(--text-secondary)]">
                      <span
                        class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]"
                        aria-hidden="true"
                      />
                      {highlight}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            data.links.length > 0 && (
              <div>
                <p class="eyebrow">Links</p>
                <ul class="mt-3 space-y-2">
                  {data.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="link-underline font-mono text-sm text-[var(--accent)]"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            data.confidential && (
              <p class="border-l-2 border-[var(--border-strong)] pl-4 text-xs leading-relaxed text-[var(--text-muted)]">
                This was commercial work on a live health platform. Implementation is described at a
                design level only.
              </p>
            )
          }
        </aside>
      </div>
    </div>
  </article>

  <nav
    class="border-t border-[var(--border-subtle)] py-12"
    aria-label="Next case study"
  >
    <div class="container-page">
      <a href={`/work/${next.id}/`} class="group block">
        <p class="eyebrow">Next</p>
        <p
          class="mt-2 text-2xl font-semibold tracking-tight transition-colors group-hover:text-[var(--accent)]"
        >
          {next.data.title}
          <span
            class="inline-block transition-transform group-hover:translate-x-1"
            aria-hidden="true">&#8594;</span
          >
        </p>
        <p class="mt-1 text-[var(--text-secondary)]">{next.data.tagline}</p>
      </a>
    </div>
  </nav>
</Layout>
