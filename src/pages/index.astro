---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CollectionHero from '../components/portfolio/CollectionHero.astro';
import ProjectChapter from '../components/portfolio/ProjectChapter.astro';
import SkateSequence from '../components/portfolio/SkateSequence.astro';
import PersonalSection from '../components/portfolio/PersonalSection.astro';
import PortfolioContact from '../components/portfolio/PortfolioContact.astro';
import '../styles/portfolio.css';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <div class="loose-parts" data-portfolio>
    <CollectionHero projects={projects} />
    {projects.map((project, index) => <>
      <ProjectChapter project={project} index={index} />
      {project.id === 'yard' && <SkateSequence />}
      {project.id === 'character-pipeline' && <SkateSequence kickflip />}
    </>)}
    <PersonalSection roles={roles} />
    <PortfolioContact />
  </div>
</Layout>
